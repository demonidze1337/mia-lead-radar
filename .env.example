# MIA Lead Radar — example configuration. Copy to .env and edit.
# Never commit .env.

# HTTP bind address and local data root
HTTP_ADDR=:8080
DATA_DIR=./data
# Optional explicit overrides
# DB_PATH=./data/mia.db
# SESSIONS_DIR=./data/sessions

# Telegram API credentials from https://my.telegram.org/apps
# Required for MTProto account login (QR or phone).
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# Public URL used in Mini App / bot buttons
WEBAPP_BASE_URL=http://localhost:8080

# Optional local dashboard passphrase. When empty, only loopback clients may
# create a local browser session.
ACCESS_TOKEN=

DEBUG=false
